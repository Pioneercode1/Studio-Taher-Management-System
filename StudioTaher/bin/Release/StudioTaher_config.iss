; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; Non-commercial use only

#define MyAppName "ستديو طاهر"
#define MyAppVersion "3.1"
#define MyAppPublisher "pioneercode, Inc."
#define MyAppURL "https://pioneercode1.github.io/pioneercode/"
#define MyAppExeName "StudioTaher.exe"

[Setup]
SignTool=mysigntool
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{BECD2754-366C-45BD-9A59-23420F5F7B28}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
UninstallDisplayIcon={app}\{#MyAppExeName}
DisableProgramGroupPage=yes
LicenseFile=E:\CSharp\Studio-Taher-3.0\StudioTaher\bin\Release\License.txt
InfoAfterFile=E:\CSharp\Studio-Taher-3.0\StudioTaher\bin\Release\README.txt
; Uncomment the following line to run in non administrative install mode (install for current user only).
;PrivilegesRequired=lowest
OutputDir=E:\CSharp\Studio-Taher-3.0\StudioTaher\bin\Release
OutputBaseFilename=StudioTaher_3.1_Setup
SetupIconFile=E:\CSharp\Studio-Taher-3.0\Imagenes II.ico
Password=123
Encryption=yes
SolidCompression=yes
WizardStyle=modern dynamic

[Languages]
Name: "arabic"; MessagesFile: "compiler:Languages\Arabic.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "E:\CSharp\Studio-Taher-3.0\StudioTaher\bin\Release\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "E:\CSharp\Studio-Taher-3.0\StudioTaher\bin\Release\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "E:\CSharp\Studio-Taher-3.0\StudioTaher\bin\Release\SqlLocalDB.msi"; DestDir: "{tmp}"; Flags: deleteafterinstall
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
Filename: "msiexec.exe"; Parameters: "/i ""{tmp}\SqlLocalDB.msi"" /qn /norestart IACCEPTSQLCLENABLEREQUIREMENTS=True"; StatusMsg: "جاري إعداد وتثبيت محرك قاعدة البيانات المحلي (LocalDB)..."; Flags: waituntilterminated

